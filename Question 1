import math

class Circle:
    """Defines a circle with center (0,0) and radius=1 as well as a view other
    parameters."""
    def __init__(self, x=0, y=0, radius=1):
        """Initializes a circle with center (0,0) and radius=1"""
        self._x = x
        self._y = y
        self._radius = radius

    def get_x(self):
        """Getter for x"""
        return self._x

    def get_y(self):
        """Getter for y"""
        return self._y

    def get_radius(self):
        """Getter for radius"""
        return self._radius

    def set_x(self, x):
        """Setter for x"""
        self._x = x

    def set_y(self, y):
        """Setter for y"""
        self._y = y

    def set_radius(self, radius):
        """Setter for radius"""
        if radius > 0:
            self._radius = radius
        else:
            raise ValueError("Radius has to be positive.")

    def getArea(self):
        """Method for getting the area of the cirle"""
        return (self._radius ** 2) * math.pi

    def getPerimeter(self):
        """Method for getting the perimeter of the circle"""
        return 2 * self._radius * math.pi

    def containPoint(self, x, y):
        """Method for checking if the point is inside the circle"""
        if self._radius >= math.sqrt((self._x - x) ** 2 + (self._y - y) ** 2):
            return True
        else:
            return False
    def containCircle(self, circle):
        """Method for checking if the cirle is inside the circle"""
        if self._radius - circle.get_radius() >= math.sqrt((self._x - circle.get_x()) ** 2 + (self._y - circle.get_y()) ** 2):
            return True
        else:
            return False
    def overlaps(self, circle):
        """Method for checking if the circle overlaps with another circle"""
        if self._radius + circle.get_radius() > math.sqrt((self._x - circle.get_x()) ** 2 + (self._y - circle.get_y()) ** 2):
            return True
        else:
            return False
