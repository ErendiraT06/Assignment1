class Employee:
    """A class that saves the employee's information."""
    def __init__(self, name, number):
        """Initializes the employee class by storing a name and number."""
        self._name = name
        self._number = number

    def get_name(self):
        """Getter for the employee name"""
        return self._name

    def get_number(self):
        """Getter for the employee number"""
        return self._number

    def set_name(self, name):
        """Setter for the employee name"""
        self._name = name

    def set_number(self, number):
        """Setter for the employee number"""
        self._number = number

class ProductionWorker(Employee):
    """A class that save information about the employee's shifts and hourly pay"""
    def __init__(self, name, number, shift=1, hourly_pay_rate=0):
        """Initializes the production worker class by storing a name and number."""
