import math

class Triangle:
    """Defines a triangle class with sides side1, side2, and side3 as well as defining
    the area and perimeter."""

    def __init__(self, side1=1.0, side2=1.0, side3=1.0):
        """Initializes the triangle with sides side1, side2, and side3"""
        self._side1 = side1
        self._side2 = side2
        self._side3 = side3

    def get_side1(self):
        """Getter for side1"""
        return self._side1

    def get_side2(self):
        """Getter for side2"""
        return self._side2

    def get_side3(self):
        """Getter for side3"""
        return self._side3

    def getArea(self):
        """Method that returns the area of the triangle"""
        s = (self._side1 + self._side2 + self._side3) / 2
        area = math.sqrt(s * (s - self._side1) * (s - self._side2) * (s - self._side3))
        return area

    def getPerimeter(self):
        """Method that returns the perimeter of the triangle"""
        return self._side1 + self._side2 + self._side3

    def toString(self):
        print(f"This is triangle with side 1 = {self._side1}, side 2 = {self._side2}, side 3 = {self._side3}")
        return True
